---
import Base from '../../layouts/Base.astro';
import catalog from '../../data/catalog.json';
import { marked } from 'marked';

interface Asset {
  id: string;
  type: string;
  title?: string;
  description?: string;
  tags?: string[];
  agents?: string[];
  layer?: string;
  priority?: number;
  stack?: { deps?: string[]; files?: string[] } | null;
  content: string;
  marketPath: string;
}

export function getStaticPaths() {
  return (catalog as { assets: Asset[] }).assets.map((a) => ({
    params: { id: a.id },
    props: { asset: a },
  }));
}

const { asset } = Astro.props;
const bodyHtml = marked.parse(asset.content || '') as string;
const base = import.meta.env.BASE_URL;
---
<Base title={`${asset.title || asset.id} · 药典`} description={asset.description}>
  <a href={base} class="back">← 返回</a>
  <article class="detail">
    <div class="detail-head">
      <span class="type-badge" data-type={asset.type}>{asset.type}</span>
      <h1>{asset.title || asset.id}</h1>
      <code class="id">{asset.id}</code>
    </div>
    {asset.description && <p class="desc">{asset.description}</p>}
    <dl class="meta">
      <dt>layer</dt><dd>{asset.layer}</dd>
      <dt>priority</dt><dd>{asset.priority}</dd>
      <dt>agents</dt><dd>{(asset.agents ?? []).join(', ') || '-'}</dd>
      <dt>tags</dt><dd>{(asset.tags ?? []).join(', ') || '-'}</dd>
      <dt>marketPath</dt><dd><code>{asset.marketPath}</code></dd>
      {asset.stack && (
        <dt>stack</dt>
        <dd>
          deps=[{(asset.stack.deps ?? []).join(', ')}]
          files=[{(asset.stack.files ?? []).join(', ')}]
        </dd>
      )}
    </dl>
    {asset.type === 'mcp' ? (
      <pre class="mcp-body">{asset.content}</pre>
    ) : (
      <div class="prose" set:html={bodyHtml} />
    )}
  </article>
</Base>
