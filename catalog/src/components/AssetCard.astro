---
interface Asset {
  id: string;
  type: string;
  title?: string;
  description?: string;
  tags?: string[];
  layer?: string;
}
interface Props {
  asset: Asset;
}
const { asset } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<a
  class="card"
  href={`${base}assets/${asset.id}/`}
  data-type={asset.type}
  data-tags={(asset.tags ?? []).join(',')}
>
  <div class="card-head">
    <span class="type-badge" data-type={asset.type}>{asset.type}</span>
    <span class="layer">{asset.layer}</span>
  </div>
  <h3>{asset.title || asset.id}</h3>
  <code class="id">{asset.id}</code>
  {asset.description && <p>{asset.description}</p>}
  {asset.tags && asset.tags.length > 0 && (
    <div class="tags">
      {asset.tags.map((t) => <span class="tag">{t}</span>)}
    </div>
  )}
</a>
